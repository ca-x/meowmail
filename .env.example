# Runtime
MEOWMAIL_BIND=0.0.0.0:8080
MEOWMAIL_DATA_DIR=data

# Authentication: local, oidc, or hybrid
MEOWMAIL_AUTH_MODE=local

# Required when local authentication is enabled on a fresh installation.
MEOWMAIL_BOOTSTRAP_ADMIN_USERNAME=admin
MEOWMAIL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional. When omitted, Meowmail creates data/vault.key with mode 0600.
# If set, keep the same secret together with database backups or mail-account
# credentials cannot be decrypted after restoration.
# MEOWMAIL_VAULT_KEY=replace-with-a-long-random-vault-secret

# Required when OIDC authentication is enabled.
# MEOWMAIL_OIDC_ISSUER=https://id.example.com
# MEOWMAIL_OIDC_CLIENT_ID=meowmail
# MEOWMAIL_OIDC_CLIENT_SECRET=replace-with-provider-client-secret
# MEOWMAIL_OIDC_REDIRECT_URL=https://mail.example.com/api/v1/auth/oidc/callback
# MEOWMAIL_OIDC_SCOPES=openid profile email
# MEOWMAIL_OIDC_FIRST_USER_ADMIN=true

# LazyCat automatically provides LAZYCAT_AUTH_OIDC_ISSUER_URI,
# LAZYCAT_AUTH_OIDC_CLIENT_ID, LAZYCAT_AUTH_OIDC_CLIENT_SECRET, and
# LAZYCAT_APP_DOMAIN; Meowmail uses them as OIDC fallbacks.
